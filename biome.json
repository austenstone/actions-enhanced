{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.wxt",
      "!!.output",
      "!!node_modules",
      "!!test-results",
      "!!playwright-report",
      "!!package-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
